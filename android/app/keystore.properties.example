# 이 파일을 복사해 keystore.properties 를 만들고 실제 값을 채운다.
# keystore.properties 는 Git에 절대 커밋하지 않는다.
#
# 키스토어 생성 명령 (최초 1회):
#   mkdir android\app\keystores
#   keytool -genkey -v -keystore android\app\keystores\<vertical>.keystore ^
#     -alias <vertical> -keyalg RSA -keysize 2048 -validity 10000 ^
#     -dname "CN=<AppName>, OU=Mobile, O=DTS, L=Seoul, ST=Seoul, C=KR" ^
#     -storepass <PASSWORD> -keypass <PASSWORD>

storeFile=keystores/lesson-on.keystore
storePassword=REPLACE_WITH_YOUR_PASSWORD
keyAlias=lesson-on
keyPassword=REPLACE_WITH_YOUR_PASSWORD
