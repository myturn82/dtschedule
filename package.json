{
  "name": "dtschedule",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lesson-on": "dotenv -e .env.lesson-on -- vite",
    "dev:shift-on": "dotenv -e .env.shift-on -- vite",
    "dev:serve-on": "dotenv -e .env.serve-on -- vite",
    "dev:class-on": "dotenv -e .env.class-on -- vite",
    "dev:work-on": "dotenv -e .env.work-on -- vite",
    "dev:salon-on": "dotenv -e .env.salon-on -- vite",
    "dev:care-on": "dotenv -e .env.care-on -- vite",
    "predev": "npm run build:tokens",
    "build": "tsc -b && vite build",
    "prebuild": "npm run build:tokens",
    "build:tokens": "style-dictionary build --config style-dictionary.config.js",
    "build:lesson-on": "npm run build:tokens && vite build --mode lesson-on",
    "build:lesson-on:android": "npm run build:lesson-on && npx cap sync android",
    "build:shift-on": "npm run build:tokens && vite build --mode shift-on",
    "build:serve-on": "npm run build:tokens && vite build --mode serve-on",
    "build:class-on": "npm run build:tokens && vite build --mode class-on",
    "build:work-on": "npm run build:tokens && vite build --mode work-on",
    "build:salon-on": "npm run build:tokens && vite build --mode salon-on",
    "build:care-on": "npm run build:tokens && vite build --mode care-on",
    "reel:landing": "vite build --config vite.promo-landing.config.ts && node scripts/record-reel-landing.js",
    "reel:blog13": "vite build --config vite.promo13.config.ts && node scripts/record-reel-blog13.js",
    "icon:dts": "node scripts/generate-icon.js dts",
    "icon:lesson-on": "node scripts/generate-icon.js lesson-on && npx @capacitor/assets generate --android",
    "icon:shift-on": "node scripts/generate-icon.js shift-on",
    "icon:serve-on": "node scripts/generate-icon.js serve-on",
    "icon:class-on": "node scripts/generate-icon.js class-on",
    "icon:work-on": "node scripts/generate-icon.js work-on",
    "icon:salon-on": "node scripts/generate-icon.js salon-on",
    "icon:care-on": "node scripts/generate-icon.js care-on",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@supabase/supabase-js": "^2.105.3",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.42.2",
    "globals": "^17.5.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.0",
    "style-dictionary": "^5.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.0"
  }
}
